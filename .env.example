# Dropbox API credentials — copy to .env and fill in.
# Create an app at https://www.dropbox.com/developers/apps (Scoped access, Full Dropbox).
# Permissions tab (READ-ONLY): account_info.read, files.metadata.read, files.content.read
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Filled in automatically by `uv run scripts/dropbox_auth.py`:
DROPBOX_REFRESH_TOKEN=

# Root folder in your Dropbox that holds the dissertation data:
DROPBOX_DATA_ROOT=/Master/LSE/CDRC

# --- Optional: regenerate the raw data sources (outputs already ship as data) ---

# Google Earth Engine (Dynamic World land cover). A project is required; a
# service account makes auth fully headless (preferred on HPC/CI), otherwise a
# one-time `earthengine authenticate` provides persistent credentials.
GFS_GEE_PROJECT=lse23-24
GFS_GEE_SERVICE_ACCOUNT=
GFS_GEE_SERVICE_ACCOUNT_KEY=

# WASDI (raw Sentinel-2 composites). Path to a JSON config holding
# USER / PASSWORD / WORKSPACE (read by wasdi.init). Licensed platform — arrange
# usage rights with the WASDI team. File is git-ignored.
GFS_WASDI_CONFIG=wasdi_config.json
